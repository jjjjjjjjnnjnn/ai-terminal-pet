{
  "name": "dsh-ai-terminal-pet",
  "version": "1.2.3",
  "description": "DeepSeek Harness Cordis bundle that mirrors session state into the AI Terminal Pet desktop overlay (Windows).",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "locale",
    "icon.svg",
    "icon.png",
    "screenshots",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "icon": "./icon.png",
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "A floating overlay for Windows: OpenCode, Claude Code, Antigravity and DeepSeek Harness sessions appear in one always-on-top panel, so you see which terminal waits without switching windows.",
        "zh": "Windows 桌面浮窗：把 OpenCode、Claude Code、Antigravity 与 DeepSeek Harness 的会话状态汇总成一个常驻置顶面板，一眼看出哪个终端在等你，不必来回切窗口。"
      },
      "capabilities": [
        "windows-overlay",
        "named-pipe",
        "session-state",
        "tray-icon",
        "no-network"
      ]
    },
    "marketplace": {
      "profiles": [
        "desktop",
        "headless",
        "web"
      ],
      "requiresBuildApproval": false,
      "manualSteps": false
    }
  },
  "scripts": {
    "verify": "node verify.mjs",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "ai-terminal-pet",
    "overlay",
    "windows",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/ai-terminal-pet.git",
    "directory": "packages/dsh-ai-terminal-pet"
  },
  "homepage": "https://github.com/jjjjjjjjnnjnn/ai-terminal-pet",
  "author": "jjjjjjjjnnjnn"
}
