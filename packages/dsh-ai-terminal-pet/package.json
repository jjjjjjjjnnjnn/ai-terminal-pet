{
  "name": "dsh-ai-terminal-pet",
  "version": "1.2.16",
  "description": "DeepSeek Harness Cordis bundle that mirrors session state into the AI Terminal Pet desktop overlay (Windows).",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "locale",
    "icon.svg",
    "icon.png",
    "screenshots",
    "screenshots.json",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "icon": "./icon.png",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "Which of your agents is waiting on you? One always-on-top Windows panel for DeepSeek Harness, Claude Code, OpenCode and Antigravity sessions: it rings only for real events, and the arrow at a row's end jumps to that terminal.",
        "zh": "哪个 agent 在等你？一块置顶的 Windows 面板汇总 DeepSeek Harness、Claude Code、OpenCode 与 Antigravity 的会话：只在真事件上响，点行尾箭头即可跳到对应终端。"
      },
      "capabilities": [
        "windows-overlay",
        "named-pipe",
        "session-state",
        "tray-icon",
        "no-network"
      ]
    },
    "marketplace": {
      "profiles": [
        "desktop",
        "headless",
        "web"
      ],
      "requiresBuildApproval": false,
      "manualSteps": false
    }
  },
  "scripts": {
    "verify": "node verify.mjs",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "ai-terminal-pet",
    "overlay",
    "windows",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/ai-terminal-pet.git",
    "directory": "packages/dsh-ai-terminal-pet"
  },
  "homepage": "https://github.com/jjjjjjjjnnjnn/ai-terminal-pet",
  "author": "jjjjjjjjnnjnn"
}
