{
  "name": "dsh-ai-terminal-pet",
  "version": "1.2.1",
  "private": true,
  "description": "Marketplace shim: the DSH plugin lives in packages/dsh-ai-terminal-pet, and this manifest lets a repository-URL install resolve to it.",
  "license": "MIT",
  "main": "./packages/dsh-ai-terminal-pet/lib/index.js",
  "exports": {
    ".": "./packages/dsh-ai-terminal-pet/lib/index.js",
    "./locale/*.json": "./packages/dsh-ai-terminal-pet/locale/*.json",
    "./icon": "./packages/dsh-ai-terminal-pet/icon.png",
    "./package.json": "./package.json"
  },
  "icon": "./packages/dsh-ai-terminal-pet/icon.png",
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-ai-terminal-pet/cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "A floating overlay for Windows: OpenCode, Claude Code, Antigravity and DeepSeek Harness sessions appear in one always-on-top panel, so you see which terminal waits without switching windows.",
        "zh": "Windows 桌面浮窗：把 OpenCode、Claude Code、Antigravity 与 DeepSeek Harness 的会话状态汇总成一个常驻置顶面板，一眼看出哪个终端在等你，不必来回切窗口。"
      },
      "capabilities": [
        "windows-overlay",
        "named-pipe",
        "session-state",
        "tray-icon",
        "no-network"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/ai-terminal-pet.git"
  },
  "homepage": "https://github.com/jjjjjjjjnnjnn/ai-terminal-pet",
  "author": "jjjjjjjjnnjnn",
  "files": [
    "packages/dsh-ai-terminal-pet"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "ai-terminal-pet",
    "overlay",
    "windows"
  ]
}
