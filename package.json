{
  "name": "dsh-ai-terminal-pet",
  "version": "1.2.4",
  "private": true,
  "description": "Marketplace shim: the DSH plugin lives in packages/dsh-ai-terminal-pet, and this manifest lets a repository-URL install resolve to it.",
  "license": "MIT",
  "main": "./packages/dsh-ai-terminal-pet/lib/index.js",
  "exports": {
    ".": "./packages/dsh-ai-terminal-pet/lib/index.js",
    "./locale/*.json": "./packages/dsh-ai-terminal-pet/locale/*.json",
    "./icon": "./packages/dsh-ai-terminal-pet/icon.png",
    "./package.json": "./package.json"
  },
  "icon": "./packages/dsh-ai-terminal-pet/icon.png",
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-ai-terminal-pet/cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "A floating overlay for Windows. DeepSeek Harness sessions show up as soon as you install this bundle; OpenCode, Claude Code and Antigravity sessions join the same panel once each of those terminals has its reporter installed.",
        "zh": "Windows 桌面浮窗。装上本插件后 DeepSeek Harness 的会话立刻出现在置顶面板里；OpenCode、Claude Code 与 Antigravity 的会话要先各自装好该终端的上报端，才会汇总进同一个面板。"
      },
      "capabilities": [
        "windows-overlay",
        "named-pipe",
        "session-state",
        "tray-icon",
        "no-network"
      ]
    },
    "marketplace": {
      "profiles": [
        "desktop",
        "headless",
        "web"
      ],
      "requiresBuildApproval": false,
      "manualSteps": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/ai-terminal-pet.git"
  },
  "homepage": "https://github.com/jjjjjjjjnnjnn/ai-terminal-pet",
  "author": "jjjjjjjjnnjnn",
  "files": [
    "packages/dsh-ai-terminal-pet"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "ai-terminal-pet",
    "overlay",
    "windows"
  ]
}
