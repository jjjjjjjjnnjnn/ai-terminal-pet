{
  "name": "dsh-ai-terminal-pet",
  "version": "1.2.16",
  "private": true,
  "description": "Marketplace shim: the DSH plugin lives in packages/dsh-ai-terminal-pet, and this manifest lets a repository-URL install resolve to it.",
  "license": "MIT",
  "main": "./packages/dsh-ai-terminal-pet/lib/index.js",
  "exports": {
    ".": "./packages/dsh-ai-terminal-pet/lib/index.js",
    "./locale/*.json": "./packages/dsh-ai-terminal-pet/locale/*.json",
    "./icon": "./packages/dsh-ai-terminal-pet/icon.png",
    "./package.json": "./package.json"
  },
  "icon": "./packages/dsh-ai-terminal-pet/icon.png",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-ai-terminal-pet/cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "Which of your agents is waiting on you? One always-on-top Windows panel for DeepSeek Harness, Claude Code, OpenCode and Antigravity sessions: it rings only for real events, and the arrow at a row's end jumps to that terminal.",
        "zh": "哪个 agent 在等你？一块置顶的 Windows 面板汇总 DeepSeek Harness、Claude Code、OpenCode 与 Antigravity 的会话：只在真事件上响，点行尾箭头即可跳到对应终端。"
      },
      "capabilities": [
        "windows-overlay",
        "named-pipe",
        "session-state",
        "tray-icon",
        "no-network"
      ]
    },
    "marketplace": {
      "profiles": [
        "desktop",
        "headless",
        "web"
      ],
      "requiresBuildApproval": false,
      "manualSteps": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/ai-terminal-pet.git"
  },
  "homepage": "https://github.com/jjjjjjjjnnjnn/ai-terminal-pet",
  "author": "jjjjjjjjnnjnn",
  "files": [
    "packages/dsh-ai-terminal-pet"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "ai-terminal-pet",
    "overlay",
    "windows"
  ]
}
