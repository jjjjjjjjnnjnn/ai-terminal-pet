# Build outputs (rebuilt by scripts/install.ps1, never committed)
*.exe
*.disabled
bin/

# Runtime / logs (machine-local state)
error.log
hang.log
*.tmp

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Backups
*.bak
*.bak-*

# Node artifacts (reporters use stdlib only, no node_modules needed)
node_modules/
package-lock.json

# Local harness output
harness-out.json

# Agent working memory (machine-local, not project source)
.workbuddy-ai/

# Generated panel preview (see README: "Seeing a layout change without a window")
panel-preview.png

# The DSH plugin package ships a prebuilt overlay so `dsh plugin add` needs no
# Go toolchain. It is the one exception to the build-output rule above: it is
# a release artifact, not a local build. Regenerate it with `npm run vendor`
# (packages/dsh-ai-terminal-pet/scripts/vendor.mjs) after rebuilding bin/.
!packages/dsh-ai-terminal-pet/vendor/AI-Terminal-Pet.exe
